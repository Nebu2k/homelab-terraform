#!/sbin/openrc-run
#
# OpenRC service for Blocky. Alpine has no Blocky package, the binary comes
# from the GitHub release (see install.sh.tftpl).
#
# Blocky runs as root. Port 53 would otherwise need cap_net_bind_service as a
# file capability, and that cannot be set reliably in an unprivileged LXC. The
# root inside the container is not root on the host, thanks to the user
# namespace mapping.

name="blocky"
description="Blocky DNS proxy and ad-blocker"

command="/usr/local/bin/blocky"
command_args="--config /etc/blocky/config.yml"
command_background="yes"
pidfile="/run/blocky.pid"
output_log="/var/log/blocky.log"
error_log="/var/log/blocky.log"

depend() {
    need net
    # The only upstream. Without Unbound, Blocky answers nothing beyond what
    # is in its own configuration.
    need unbound
    after firewall
}
