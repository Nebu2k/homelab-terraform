#!/bin/sh
#
# Sets up Blocky and Unbound in the LXC and keeps both current. Runs on the
# Proxmox host, not in the container, and talks to it through "pct": the
# container has neither sshd nor cloud-init, and pulling both in just for
# provisioning would be more attack surface than benefit.
#
# The script is idempotent and runs again on every change to the Blocky
# configuration. It installs only what is missing and restarts the services
# only when their configuration actually changed.
#
# Terraform renders this file from blocky/install.sh.tftpl.

set -eu

vmid="${vmid}"
snippets="${snippets_dir}"

log() { echo "[blocky-install] $*"; }

# ---------------------------------------------------------------- Container
# After a "pct start" the container runs but has no route yet. Rather than
# waiting for a network symptom, the first action that really needs the
# network is retried.
pct status "$vmid" | grep -q running || pct start "$vmid"

i=0
until pct exec "$vmid" -- apk update >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -lt 30 ] || { log "Container $vmid cannot reach the apk mirrors"; exit 1; }
  sleep 2
done

# ------------------------------------------------------------------ Packages
#
# node_exporter is not decorative: through the textfile collector it carries
# the result of the config sync to Prometheus. Without it a permanently
# failing sync would be invisible and Blocky would quietly run on an old
# state.
pct exec "$vmid" -- apk add --no-cache unbound ca-certificates curl \
  prometheus-node-exporter prometheus-node-exporter-openrc

# ------------------------------------------------------------- Configuration
pct exec "$vmid" -- mkdir -p /etc/blocky

changed_blocky=0
changed_unbound=0

sync_file() {
  src="$1"
  dst="$2"
  if ! pct exec "$vmid" -- test -f "$dst" || \
     [ "$(md5sum "$src" | cut -d' ' -f1)" != "$(pct exec "$vmid" -- md5sum "$dst" | cut -d' ' -f1)" ]; then
    pct push "$vmid" "$src" "$dst" --perms 0644
    return 1
  fi
  return 0
}

# config.yml is deliberately not in this list. It has exactly one owner, and
# that is the sync job further down, which fetches it from the cluster repo.
sync_file "$snippets/blocky-unbound.conf" /etc/unbound/unbound.conf || changed_unbound=1
sync_file "$snippets/blocky-unbound.confd" /etc/conf.d/unbound || changed_unbound=1

# ----------------------------------------------------------- OpenRC services
sync_file "$snippets/blocky-openrc.sh" /etc/init.d/blocky || changed_blocky=1
pct exec "$vmid" -- chmod 0755 /etc/init.d/blocky

changed_exporter=0
sync_file "$snippets/blocky-node-exporter.confd" /etc/conf.d/node-exporter || changed_exporter=1

# ---------------------------------------------------------------- Config sync
# Into /etc/periodic/15min, because busybox crond walks those directories
# anyway: no crontab entry of our own that could be added twice on the next
# run. The quarter hour is at the same time the distance to the cluster
# instance, which ArgoCD follows within minutes.
pct exec "$vmid" -- mkdir -p /var/lib/node_exporter/textfile
pct exec "$vmid" -- chmod 0755 /var/lib/node_exporter/textfile
sync_file "$snippets/blocky-config-sync.sh" /etc/periodic/15min/blocky-config-sync || true
pct exec "$vmid" -- chmod 0755 /etc/periodic/15min/blocky-config-sync

# -------------------------------------------------------------------- Blocky
# No Alpine package, so the release binary. Statically linked Go, which means
# it also runs against musl. Which version is not decided here: the hourly
# version sync follows the cluster instance's image tag. --bootstrap installs
# only into a container without a binary, so an apply never skips its soak.
sync_file "$snippets/blocky-version-sync.sh" /etc/periodic/hourly/blocky-version-sync || true
pct exec "$vmid" -- chmod 0755 /etc/periodic/hourly/blocky-version-sync
pct exec "$vmid" -- rc-update add crond default
pct exec "$vmid" -- /etc/periodic/hourly/blocky-version-sync --bootstrap

# Trust anchor for DNSSEC validation. unbound-anchor creates the file on the
# first run and updates it afterwards via RFC 5011.
pct exec "$vmid" -- sh -c 'mkdir -p /var/lib/unbound \
  && unbound-anchor -a /var/lib/unbound/root.key || true'
pct exec "$vmid" -- chown -R unbound:unbound /var/lib/unbound

pct exec "$vmid" -- rc-update add unbound default
pct exec "$vmid" -- rc-update add blocky default
pct exec "$vmid" -- rc-update add node-exporter default

if [ "$changed_exporter" -eq 1 ] || ! pct exec "$vmid" -- rc-service node-exporter status >/dev/null 2>&1; then
  log "Restarting node_exporter"
  pct exec "$vmid" -- rc-service node-exporter restart
fi

# Unbound first: Blocky hangs off it as its only upstream.
if [ "$changed_unbound" -eq 1 ] || ! pct exec "$vmid" -- rc-service unbound status >/dev/null 2>&1; then
  log "Restarting Unbound"
  pct exec "$vmid" -- rc-service unbound restart
fi

# The sync job fetches the configuration, validates it and restarts Blocky if
# something changed. Triggering it here once by hand saves a "different the
# first time" special case: the same code runs at setup and every 15 minutes
# afterwards.
log "Fetching the configuration from the cluster repo"
pct exec "$vmid" -- /etc/periodic/15min/blocky-config-sync

if ! pct exec "$vmid" -- test -s /etc/blocky/config.yml; then
  log "No configuration in the container. Can it reach raw.githubusercontent.com?"
  exit 1
fi

if [ "$changed_blocky" -eq 1 ] || \
   ! pct exec "$vmid" -- rc-service blocky status >/dev/null 2>&1; then
  log "Restarting Blocky"
  pct exec "$vmid" -- rc-service blocky restart
fi

# ----------------------------------------------------------------- Acceptance
i=0
until pct exec "$vmid" -- /usr/local/bin/blocky healthcheck >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -lt 30 ] || { log "Blocky does not answer after 60s"; exit 1; }
  sleep 2
done

log "Blocky $(pct exec "$vmid" -- cat /etc/blocky/.version) is running in CT $vmid"
