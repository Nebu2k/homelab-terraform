#!/bin/sh
#
# Fetches the Blocky configuration from the cluster repo and applies it. Runs
# as a cron job INSIDE the container, not on the Proxmox host.
#
# The point: config.yml is the shared truth of both Blocky instances. The
# cluster instance gets every change from ArgoCD without anyone doing
# anything. Without this script the LXC would need a "terraform apply" by
# hand for it, and the two resolvers would drift apart until someone
# remembered.
#
# Terraform drops the script off and stays the owner of the container, but no
# longer of its configuration.
#
# Three safeguards, because both instances could otherwise fall at once:
#
#   1. "blocky validate" runs BEFORE the restart. A configuration Blocky does
#      not accept is never installed in the first place.
#   2. The running version stays behind as .last-good. If Blocky fails to
#      start with the new one anyway, the script rolls back and restarts.
#   3. The timer runs at a distance from the cluster instance. ArgoCD is
#      there in minutes, here a quarter of an hour passes: if a change goes
#      wrong, it is visible in the cluster while this side still runs the
#      old state.
#
# Terraform renders this file from blocky/config-sync.sh.tftpl.

set -eu

# cron and "pct exec" do not bring /usr/local/bin along, which is where the
# Blocky binary lives. Without this line "blocky validate" below fails with
# "not found", and the script takes a perfectly healthy configuration for a
# broken one.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

blocky=/usr/local/bin/blocky

url="${config_url}"
config=/etc/blocky/config.yml
staging=/etc/blocky/config.yml.new
lastgood=/etc/blocky/config.yml.last-good
statefile=${textfile_dir}/blocky-config-sync.prom

log() { logger -t blocky-config-sync "$*"; echo "[blocky-config-sync] $*"; }

# Result of the last run as a Prometheus textfile. Without it a permanently
# failing sync would be silent: Blocky keeps running, just on an old state.
write_state() {
  mkdir -p "$(dirname "$statefile")"
  cat > "$statefile.tmp" <<STATE
# HELP blocky_config_sync_success Last config sync run successful (1) or not (0)
# TYPE blocky_config_sync_success gauge
blocky_config_sync_success $1
# HELP blocky_config_sync_timestamp_seconds Time of the last successful run
# TYPE blocky_config_sync_timestamp_seconds gauge
blocky_config_sync_timestamp_seconds $2
STATE
  mv "$statefile.tmp" "$statefile"
}

last_ts=$(awk '/^blocky_config_sync_timestamp_seconds /{print $2}' "$statefile" 2>/dev/null || true)
last_ts=$${last_ts:-0}

# -------------------------------------------------------------------- Fetch
if ! curl -fsSL --max-time 30 "$url" -o "$staging"; then
  log "Download failed, keeping the running state"
  write_state 0 "$last_ts"
  exit 0
fi

if [ -f "$config" ] && cmp -s "$staging" "$config"; then
  rm -f "$staging"
  write_state 1 "$(date +%s)"
  exit 0
fi

# ------------------------------------------------------------------ Validate
# A missing binary is something other than a broken configuration and must
# not be reported as one.
if [ ! -x "$blocky" ]; then
  log "$blocky missing, sync aborted"
  rm -f "$staging"
  write_state 0 "$last_ts"
  exit 1
fi

# Safeguard 1. Blocky only reads the file here, nothing starts up. The error
# message is logged along with it, otherwise the journal only says "invalid".
if ! validate_out=$("$blocky" validate --config "$staging" 2>&1); then
  log "New configuration is invalid, it will NOT be installed: $validate_out"
  rm -f "$staging"
  write_state 0 "$last_ts"
  exit 1
fi

# --------------------------------------------------------------------- Apply
log "New configuration found and valid, applying it"
[ -f "$config" ] && cp "$config" "$lastgood"
mv "$staging" "$config"

# After the restart Blocky does not listen on port 53 right away: it loads the
# blocklists first. Without this wait the healthcheck reports a failed start
# and the safeguard below rolls back a perfectly healthy configuration.
if rc-service blocky restart >/dev/null 2>&1; then
  i=0
  while [ "$i" -lt 30 ]; do
    if "$blocky" healthcheck >/dev/null 2>&1; then
      log "Blocky is running with the new configuration"
      write_state 1 "$(date +%s)"
      exit 0
    fi
    i=$((i + 1))
    sleep 2
  done
fi

# Safeguard 2. Valid does not mean runnable: an unreachable upstream or an
# occupied port only shows up here.
log "Blocky does not come up with the new configuration, rolling back"
if [ -f "$lastgood" ]; then
  cp "$lastgood" "$config"
  rc-service blocky restart >/dev/null 2>&1 || true
fi
write_state 0 "$last_ts"
exit 1
