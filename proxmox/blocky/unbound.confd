# /etc/conf.d/unbound
#
# Belt to the braces in unbound.conf (so-sndbuf: 0): if Unbound does write
# something to stderr at startup after all, it lands in a file rather than at
# a console, which does not exist at boot time. Without this, every future
# startup warning costs the service, silently.
error_log=/var/log/unbound-start.log
output_log=/var/log/unbound-start.log
