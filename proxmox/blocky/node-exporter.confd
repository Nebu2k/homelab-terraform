# /etc/conf.d/node-exporter
#
# The textfile collector is the reason a node_exporter runs on this container
# at all: without it a permanently failing config sync would be invisible.
# Blocky would simply keep running on the old state, which is exactly the
# drift between the two instances the sync is meant to prevent.
#
# That CPU, memory and disk of the container become visible too is a bonus:
# the host metrics land in the same job=node-exporter as pve and macmini, and
# therefore in the same rules and dashboards.
ARGS="--collector.textfile.directory=/var/lib/node_exporter/textfile"
