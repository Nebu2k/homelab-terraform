#!/bin/sh
# Points the Postfix on the Proxmox host at SES. Written by Terraform, see
# postfix-ses.tf. The sasl_passwd file is already in place when this runs.
set -eu

# Debian ships Postfix without the SASL mechanisms. Without this package the
# handshake ends in "no worthy mechs found" and every mail stays queued.
dpkg -s libsasl2-modules >/dev/null 2>&1 || \
  DEBIAN_FRONTEND=noninteractive apt-get install -y libsasl2-modules

chmod 600 /etc/postfix/sasl_passwd
# hash, not lmdb: Postfix 3.10 on Debian 13 has no lmdb map type.
postmap hash:/etc/postfix/sasl_passwd

# SES only accepts senders inside the verified domain, and cron and smartd
# write as root@proxmox.elmstreet79.de. Envelope and header both get rewritten,
# DMARC checks the header.
cat > /etc/postfix/sender_canonical <<'EOF'
/.*/    ${sender}
EOF

cat > /etc/postfix/header_check <<'EOF'
/^From:.*/    REPLACE From: Proxmox VE <${sender}>
EOF

postconf -e "relayhost = [${relay_host}]:${relay_port}"
postconf -e "smtp_sasl_auth_enable = yes"
postconf -e "smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd"
postconf -e "smtp_sasl_security_options = noanonymous"
postconf -e "smtp_tls_security_level = encrypt"
postconf -e "smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt"
postconf -e "sender_canonical_maps = regexp:/etc/postfix/sender_canonical"
postconf -e "smtp_header_checks = regexp:/etc/postfix/header_check"

systemctl reload postfix
# Anything still queued was addressed before the relay existed.
postqueue -f
