# Vorlage fuer terraform.tfvars. Kopieren, Werte eintragen, fertig:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars ist gitignored und wird nie committet.
#
# Hier stehen nur die Variablen OHNE Default. Alles andere, insbesondere die
# Groesse und der Storage der Talos-VMs, ist in variables.tf hinterlegt und dort
# auch begruendet. Bewusst so herum: ein Wert, der nur in dieser gitignoreten
# Datei stuende, waere fuer jeden anderen Klon des Repos verschwunden.

proxmox_endpoint = "https://192.168.2.8:8006"
proxmox_node     = "proxmox"

# Statt hier im Klartext geht auch die Umgebung, dann die Zeile weglassen:
#   export TF_VAR_proxmox_password=...
proxmox_password = "..."
