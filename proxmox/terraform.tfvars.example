# Vorlage fuer terraform.tfvars:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars ist gitignored.
#
# Hier stehen nur die Variablen ohne Default. Alles andere, insbesondere Groesse
# und Storage der Talos-VM, ist in variables.tf hinterlegt.

proxmox_endpoint = "https://<proxmox-host>:8006"
proxmox_node     = "proxmox"

# Alternativ ueber die Umgebung, dann die Zeile weglassen:
#   export TF_VAR_proxmox_password=...
proxmox_password = "..."
