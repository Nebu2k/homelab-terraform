{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],

  timezone: 'Europe/Berlin',

  // Kein "schedule" hier. Wann Renovate laeuft, steuert der Cron in
  // kubernetes-homelab/.github/workflows/renovate.yml; dieses Repo hat keinen
  // eigenen Workflow und steht dort in RENOVATE_REPOSITORIES mit drin. Die
  // Konfiguration liest Renovate je Repo aus dem Repo selbst, die beiden
  // renovate.json5 sind unabhaengig voneinander.

  semanticCommits: 'enabled',

  // Der PR entsteht sofort und wartet nicht auf einen Branch-Status.
  prCreation: 'immediate',

  // Kein Automerge: nichts in diesem Repo rollt sich selbst aus. Jeder Merge ist
  // eine Notiz, die erst durch ein "terraform apply" von Hand wirksam wird.
  automerge: false,

  packageRules: [
    {
      matchManagers: ['terraform'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'ci',
    },
    // Der ArgoCD-Chart des Clusters. Vor dem Apply eines Chart-Majors pruefen,
    // dass argocd-cm die Keys accounts.readonly und timeout.reconciliation noch
    // hat: das Chart liefert die ConfigMap mit, die App argocd-config patcht nur
    // hinein.
    {
      matchPackageNames: ['argo-cd'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'argocd',
    },
    // Der bpg-Provider ist die Schnittstelle zu den Cluster-VMs. Ein Major kann
    // Ressourcen umbenennen, also nie ohne "terraform plan" gegen alle Stacks.
    {
      matchPackageNames: ['bpg/proxmox'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'proxmox',
    },
  ],

  // Die Provider stehen als Bereiche in required_providers. Renovate meldet sich
  // damit erst, wenn eine neue Version den Bereich verlaesst, also bei einem
  // Major. Patches zieht "terraform init -upgrade" beim naechsten Apply mit.
  //
  // .terraform.lock.hcl ist committet, eine je Stack. Renovate zieht sie beim
  // Anheben eines Bereichs nur mit, wenn das Image ein terraform-Binary hat;
  // sonst bleibt die Lock-Datei stehen und das naechste "terraform init"
  // verlangt ein "-upgrade". Die Dateien tragen nur darwin_arm64-Hashes, ein auf
  // einem Linux-Runner neu geschriebener Lock wuerde die Plattform tauschen
  // statt ergaenzen ("terraform providers lock" mit beiden -platform).
  customManagers: [
    // Die argo-cd-Chart-Version steckt im default einer Variablen und ist damit
    // fuer den terraform-Manager unsichtbar; er kennt nur required_providers und
    // Module.
    {
      customType: 'regex',
      managerFilePatterns: ['argocd-talos/variables.tf'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+default\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
    },
  ],
}
