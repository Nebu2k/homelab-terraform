{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    ':dependencyDashboard',
    // TERRAFORM_VERSION in .github/workflows/validate.yml.
    'customManagers:githubActionsVersions',
  ],

  timezone: 'Europe/Berlin',

  // No "schedule" here. The cron in kubernetes-homelab/.github/workflows/
  // renovate.yml runs this repo as well (RENOVATE_REPOSITORIES); each repo
  // carries its own configuration.

  semanticCommits: 'enabled',

  // validate.yml runs on pull_request, never on a branch push, so the PR has
  // to exist before any status can.
  prCreation: 'immediate',

  // A merge here rolls nothing out, it changes what the next manual
  // "terraform apply" uses. So everything merges once validate.yml is green,
  // which catches a provider whose schema no longer fits the configuration.
  // Majors stay manual (rule below).
  automerge: true,
  automergeType: 'pr',
  // Renovate merges itself: main has no required checks, so GitHub's
  // auto-merge would not wait for validate.yml.
  platformAutomerge: false,
  rebaseWhen: 'conflicted',

  packageRules: [
    {
      matchManagers: ['terraform'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'ci',
    },
    {
      matchPackageNames: ['bpg/proxmox'],
      semanticCommitScope: 'proxmox',
    },
    // A major renames resources (cloudflare v5) and needs a migration with a
    // "terraform plan" against the stack, not just a green validate.
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
  ],
}
