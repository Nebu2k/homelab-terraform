#cloud-config

package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates
  - gnupg

# Create swap file (512MB)
swap:
  filename: /swapfile
  size: 536870912
  maxsize: 536870912

write_files:
  # Docker Compose file
  - path: /opt/pangolin/docker-compose.yml
    permissions: '0644'
    content: |
      ${indent(6, docker_compose)}

  # Pangolin config
  - path: /opt/pangolin/config/config.yml
    permissions: '0644'
    content: |
      ${indent(6, config_yml)}

  # Traefik static config
  - path: /opt/pangolin/config/traefik/traefik_config.yml
    permissions: '0644'
    content: |
      ${indent(6, traefik_config_yml)}

  # Traefik dynamic config
  - path: /opt/pangolin/config/traefik/dynamic_config.yml
    permissions: '0644'
    content: |
      ${indent(6, dynamic_config_yml)}

runcmd:
  # Set swappiness
  - echo 'vm.swappiness=60' >> /etc/sysctl.conf
  - sysctl vm.swappiness=60

  # Install Docker
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # Enable and start Docker
  - systemctl enable docker
  - systemctl start docker

  # Create directories
  - mkdir -p /opt/pangolin/config/traefik/logs
  - mkdir -p /opt/pangolin/config/letsencrypt
  - mkdir -p /opt/pangolin/config/db

  # Download GeoLite2 database
  - |
    curl -sSL "https://download.maxmind.com/app/geoip_download?edition_id=GeoLite2-Country&license_key=${maxmind_license_key}&suffix=tar.gz" \
      | tar -xzf - --strip-components=1 -C /opt/pangolin/config/ --wildcards "*/GeoLite2-Country.mmdb"

  # Set permissions
  - chown -R root:root /opt/pangolin

  # Start Pangolin stack
  - cd /opt/pangolin && docker compose up -d

final_message: "Pangolin setup complete after $UPTIME seconds"
